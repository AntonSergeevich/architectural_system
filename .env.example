# Значения ниже — для боевого сервера. Локально файл .env вообще не нужен:
# без него включаются режим разработки и SQLite.
#
# ВНИМАНИЕ. Этот файл — образец, он лежит в репозитории. Настоящие ключи,
# токены и пароли пишутся ТОЛЬКО в .env на сервере (он в .gitignore,
# права 600). Ключ, попавший в репозиторий, считается скомпрометированным
# и подлежит замене, даже если коммит потом удалили.
#
# --- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=поменяйте-на-длинную-случайную-строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=da-des.ru,www.da-des.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://da-des.ru,https://www.da-des.ru
SITE_URL=https://da-des.ru

# --- База данных -----------------------------------------------------------
# ВАЖНО: пока эти строки закомментированы, используется SQLite — так и надо
# для локальной разработки, никакой PostgreSQL на своей машине ставить
# не нужно. На сервере снимите комментарии и подставьте пароль из пункта 3
# инструкции DEPLOY.md.
#POSTGRES_DB=dades
#POSTGRES_USER=dades
#POSTGRES_PASSWORD=
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5432

# --- Почта -----------------------------------------------------------------
# Порт задаёт режим шифрования: 465 — SSL, 587 — STARTTLS.
# Пароль — не пароль от Яндекс-почты, а пароль приложения: Яндекс ID →
# Безопасность → Пароли приложений → Почта.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=dark-ost@ya.ru
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Дарья <dark-ost@ya.ru>

# --- Уведомления: Telegram -------------------------------------------------
# Бот @daarch_bot пишет о новых заявках. Токен берётся у @BotFather —
# это пароль от бота, в репозиторий он не попадает никогда.
# TELEGRAM_CHAT_ID — кому писать. Узнать: написать боту любое сообщение
# и открыть https://api.telegram.org/bot<ТОКЕН>/getUpdates, взять оттуда
# message.chat.id. Проверить настройку: python manage.py telegram_test
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Оплата: GetPlatinum ---------------------------------------------------
# Базовый адрес API: https://<ваш-аккаунт>.getplatinum.ru/api/public/pay
# Ключ: личный кабинет → Настройки → организация → API-ключ.
# Он же проверяет подпись коллбэков — отдельного секрета у них нет.
# Пока поля пустые, приём оплат выключен: кнопка не показывается,
# счета отмечаются оплаченными вручную.
GETPLATINUM_API_URL=
GETPLATINUM_API_KEY=
# Ставка НДС для кассового чека. Для самозанятого — none (не облагается).
GETPLATINUM_VAT=none

# --- Регламент -------------------------------------------------------------
WORKDAY_START_HOUR=10
WORKDAY_END_HOUR=19

LOG_LEVEL=INFO
