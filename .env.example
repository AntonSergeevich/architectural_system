# --- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=поменяйте-на-длинную-случайную-строку
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=example.ru,www.example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.ru,https://www.example.ru
SITE_URL=https://example.ru

# --- База данных -----------------------------------------------------------
# Без этих переменных используется SQLite — только для локальной разработки.
POSTGRES_DB=darya
POSTGRES_USER=darya
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Почта -----------------------------------------------------------------
# Порт задаёт режим шифрования: 465 — SSL, 587 — STARTTLS.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.yandex.ru
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Дарья <noreply@example.ru>

# --- Оплата: GetPlatinum ---------------------------------------------------
# Реквизиты выдаёт платёжный сервис. Пока они пустые, приём оплат выключен:
# кнопка не показывается, счета отмечаются оплаченными вручную.
GETPLATINUM_MERCHANT_ID=
GETPLATINUM_SECRET_KEY=
GETPLATINUM_API_URL=
GETPLATINUM_TEST_MODE=1

# --- Регламент -------------------------------------------------------------
WORKDAY_START_HOUR=10
WORKDAY_END_HOUR=19

LOG_LEVEL=INFO
