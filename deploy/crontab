# Регулярные задачи. Установить: crontab -u dades deploy/crontab
#
# Напоминания о просроченных касаниях по заявкам: раз в час в рабочее время.
# Ночью и в выходные не шлём — регламент Дарьи это прямо запрещает,
# и система не должна его нарушать за неё.
0 10-19 * * 1-5  cd /srv/dades && .venv/bin/python manage.py remind_overdue

# Сверка незакрытых счетов с GetPlatinum. Их коллбэк приходит ровно один раз
# и повторов не имеет: если он не дошёл, платёж останется неучтённым.
17 * * * *  cd /srv/dades && .venv/bin/python manage.py sync_payments

# Карточки, пролежавшие в архиве месяц, удаляются окончательно.
# Архив — страховка от одного неверного нажатия, а не вечное хранилище
# данных людей, с которыми работа закончена.
40 4 * * *  cd /srv/dades && .venv/bin/python manage.py purge_archive

# Резервные копии базы и файлов — каждую ночь.
30 3 * * *  /srv/dades/deploy/backup.sh >> /var/log/dades-backup.log 2>&1

# Сертификат здесь не обновляется. Это crontab пользователя dades,
# а certbot без root не может ни писать в /etc/letsencrypt, ни
# перезапускать nginx — строка только сыпала ошибками каждую ночь.
# Обновлением занимается certbot.timer, который пакет certbot ставит сам
# и запускает от root. Проверить: systemctl list-timers | grep certbot
