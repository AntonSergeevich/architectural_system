# Копировать в /etc/systemd/system/dades.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now dades
[Unit]
Description=Gunicorn для da-des.ru
After=network.target postgresql.service

[Service]
Type=notify
User=dades
Group=www-data
WorkingDirectory=/srv/dades
EnvironmentFile=/srv/dades/.env
RuntimeDirectory=dades
# Сокет вместо порта: nginx и приложение на одной машине, лишний сетевой
# стек между ними не нужен, а права на файл сокета проверяются ядром.
ExecStart=/srv/dades/.venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/dades/gunicorn.sock \
    --workers 3 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
