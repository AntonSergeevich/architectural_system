# Копировать в /etc/systemd/system/darya.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now darya
[Unit]
Description=Gunicorn для daarch.ru
After=network.target postgresql.service

[Service]
Type=notify
User=daarch
Group=www-data
WorkingDirectory=/srv/daarch
EnvironmentFile=/srv/daarch/.env
RuntimeDirectory=daarch
# Сокет вместо порта: nginx и приложение на одной машине, лишний сетевой
# стек между ними не нужен, а права на файл сокета проверяются ядром.
ExecStart=/srv/daarch/.venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/daarch/gunicorn.sock \
    --workers 3 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
